rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Master Catch-All Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (
          request.auth.token.email != null &&
          (request.auth.token.email == 'AlHelal711@gmail.com' || request.auth.token.email == 'alhelal711@gmail.com')
        )
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- 1. Users Collection ---
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId)
        && isValidId(userId)
        && incoming().keys().hasAll(['uid', 'email', 'role', 'status', 'createdAt'])
        && incoming().uid == request.auth.uid
        && (incoming().role == 'user' || isAdmin())
        && incoming().email is string
        && incoming().email.size() <= 256;
      allow update: if (isOwner(userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'lastLoginAt', 'settings'])
      ) || isAdmin();
      allow delete: if isAdmin();
    }

    // --- 2. Projects Collection ---
    match /projects/{projectId} {
      allow get: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow list: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn()
        && isValidId(projectId)
        && incoming().keys().hasAll(['projectId', 'userId', 'name', 'tool', 'status', 'createdAt'])
        && incoming().userId == request.auth.uid
        && incoming().name is string && incoming().name.size() <= 120
        && incoming().tool is string && incoming().tool.size() <= 64;
      allow update: if (isSignedIn()
        && resource.data.userId == request.auth.uid
        && incoming().userId == existing().userId
        && incoming().projectId == existing().projectId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'status', 'resultFile', 'originalFile', 'updatedAt', 'metadata'])
      ) || isAdmin();
      allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // --- 3. Generations Log Collection ---
    match /generations/{generationId} {
      allow get, list: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn()
        && isValidId(generationId)
        && incoming().keys().hasAll(['generationId', 'userId', 'tool', 'status', 'createdAt'])
        && incoming().userId == request.auth.uid
        && incoming().tool is string && incoming().tool.size() <= 64;
      // Immutable generation audit logs
      allow update: if false;
      allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // --- 4. Files Metadata Collection ---
    match /files/{fileId} {
      allow get, list: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn()
        && isValidId(fileId)
        && incoming().keys().hasAll(['fileId', 'userId', 'storagePath', 'name', 'size', 'createdAt'])
        && incoming().userId == request.auth.uid
        && incoming().size <= 25 * 1024 * 1024;
      allow update: if false;
      allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // --- 5. Tool Usage Metrics ---
    match /tool_usage/{id} {
      allow create: if isSignedIn()
        && isValidId(id)
        && incoming().userId == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // --- 6. Favorites Collection ---
    match /favorites/{favoriteId} {
      allow get, list: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn()
        && isValidId(favoriteId)
        && incoming().userId == request.auth.uid;
      allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // --- 7. Notifications Collection ---
    match /notifications/{notificationId} {
      allow get, list: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if (isSignedIn() && incoming().userId == request.auth.uid) || isAdmin();
      allow update: if (isSignedIn()
        && resource.data.userId == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['read'])
      ) || isAdmin();
      allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // --- 8. Admin Logs ---
    match /admin_logs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // --- 9. System Settings ---
    match /system_settings/{settingId} {
      allow read: if true; // Public read for maintenance state, rate limits & enabled tools
      allow write: if isAdmin();
    }

    // --- 10. Admins Roster ---
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
